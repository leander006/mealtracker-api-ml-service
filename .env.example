# Main database - Neon Postgres connection string (food library, nutrition
# data, and the training-DB rotation pointer). Get this from your Neon
# project dashboard -> Connection Details. Keep sslmode=require.
# Neon's free tier auto-suspends its compute after a few idle minutes,
# which can kill open connections - db.py already sets pool_pre_ping=True
# so SQLAlchemy tests/replaces a stale connection before using it, no
# extra config needed here (unlike the backend's HikariCP, tuned separately
# for the same reason - see backend/src/main/resources/application.yml).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/mealtracker?sslmode=require

# Detector: "mock" needs no weights file and is the default for local dev.
# Switch to "real" once you have a trained .pt file.
DETECTOR_MODE=mock
YOLO_WEIGHTS_PATH=weights/food_yolov8.pt
YOLO_CONFIDENCE_THRESHOLD=0.4

# USDA FoodData Central - only needed to run nutrition/usda_loader.py to seed
# the library. Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Cloudinary - free tier account, from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Round-robin training/feedback DBs - comma-separated Postgres URLs, no
# spaces around commas. Start with 1; add more as each fills up. These can
# be Neon, Supabase, or any free-tier Postgres provider - mix and match is fine.
TRAINING_DB_URLS=postgresql://user:password@host1/db1?sslmode=require,postgresql://user:password@host2/db2?sslmode=require
TRAINING_DB_CAPACITY_MB=450
TRAINING_DB_ROTATION_THRESHOLD=0.8

# JSON array of origins allowed to call this API directly (the UI's "add
# food" and "submit correction" calls hit ml-service directly, bypassing
# the backend - see ui/src/pages/Search.jsx and Scan.jsx).
# Local: ["http://localhost:5173"]
# Prod: add your Vercel URL, e.g. ["https://mealtracker.vercel.app"]
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]
